POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=replace-with-a-long-random-password
ConnectionStrings__Telemetry=Host=postgres;Port=5432;Database=telemetry;Username=telemetry;Password=replace-with-a-long-random-password
DASHBOARD_ADMIN_KEY=replace-with-a-long-random-admin-key
DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
TELEMETRY_WEB_PORT=8091
