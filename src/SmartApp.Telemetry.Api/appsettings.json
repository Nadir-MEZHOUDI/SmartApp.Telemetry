{
  "ConnectionStrings": {
    "Telemetry": "Host=localhost;Port=5433;Database=Telemetry;Username=postgres;Password=postgres"
  },
  "Dashboard": {
    "AdminKey": "",
    "AllowedOrigin": "http://localhost:8080"
  },
  "Telemetry": {
    "MaintenanceIntervalHours": 24,
    "RawEventRetentionDays": 90,
    "ErrorRetentionDays": 180
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
